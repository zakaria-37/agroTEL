# Copiez ce fichier en ".env" et remplissez vos vraies valeurs.
# Le fichier ".env" ne doit JAMAIS être commité ni partagé (voir .gitignore).

# Clé API pour le chatbot — API Groq officielle : https://console.groq.com
GROQ_API_KEY=

# Email Gmail utilisé pour envoyer les alertes (mot de passe d'application, pas votre vrai mot de passe)
EMAIL_EXPEDITEUR=
EMAIL_MOT_DE_PASSE=
EMAIL_DESTINATAIRES=exemple1@gmail.com,exemple2@gmail.com

# Clé secrète que l'ESP32-CAM doit envoyer (header X-Device-Key) pour poster une alerte PIR.
# Générez-en une forte, ex: python3 -c "import secrets;print(secrets.token_hex(24))"
DEVICE_API_KEY=

# Origine(s) autorisées pour les requêtes CORS depuis un navigateur.
# En local, laissez "*". En production, mettez votre domaine exact.
ALLOWED_ORIGINS=*

# (Optionnel) Mot de passe du compte admin créé au premier démarrage.
# Si vide, un mot de passe aléatoire est généré et affiché une seule fois dans les logs.
ADMIN_PASSWORD=
